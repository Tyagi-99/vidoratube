# VidoraTube render worker — environment reference.
#
# Copy to `.env` at the REPO ROOT (not here) and fill in the required values:
#
#   cp worker/.env.example .env
#
# The root `.env` is gitignored; `scripts/deploy-worker.sh` and
# `docker-compose.yml` (env_file) both read it from the repo root.
# NEVER commit real values. NEVER pass secrets as CLI args (shell history).

# ── REQUIRED ──────────────────────────────────────────────────────────────

# SUPABASE_URL — your Supabase project URL.
#   Secret? No (it's public), but the pair below makes it sensitive.
#   Where: Lovable dashboard → your project → Settings → API → Project URL.
SUPABASE_URL=

# SUPABASE_SERVICE_ROLE_KEY — the Supabase service_role key.
#   Secret? YES. This is the most sensitive value in this file: it bypasses
#   all RLS. Worker-only — it must never appear in browser code, bundles,
#   or client-side env (VITE_*). If leaked, rotate it immediately in the
#   Supabase dashboard (Settings → API → service_role).
#   Where: same place as SUPABASE_URL → "service_role" key (the "secret" key).
SUPABASE_SERVICE_ROLE_KEY=

# ── STORAGE ───────────────────────────────────────────────────────────────

# RENDER_BUCKET — Supabase Storage bucket for render inputs/outputs.
#   Secret? No. Where: Lovable dashboard → Storage; the deploy checklist
#   requires the `generated-videos` bucket to exist and be PRIVATE.
RENDER_BUCKET=generated-videos

# BRAND_LOGOS_BUCKET — Storage bucket for agency brand-kit logos.
#   Secret? No. Same place; `brand-logos` bucket, PRIVATE.
BRAND_LOGOS_BUCKET=brand-logos

# ── FFMPEG BINARIES ───────────────────────────────────────────────────────

# FFMPEG_PATH — path to the ffmpeg binary.
#   Secret? No. Where: the Docker image already ships ffmpeg at `ffmpeg` on
#   PATH — leave the default unless you run outside Docker with a custom path.
FFMPEG_PATH=ffmpeg

# FFPROBE_PATH — path to the ffprobe binary (used to measure output duration).
#   Secret? No. Same as above: leave the default inside Docker.
FFPROBE_PATH=ffprobe

# ── IDENTITY / TUNING ─────────────────────────────────────────────────────

# WORKER_ID — unique ID for this worker instance.
#   Secret? No. Where: you choose it. It appears in claim leases, the
#   worker_heartbeats table, and the /status page ("worker <id>").
#   docker-compose.yml overrides this from the WORKER_ID shell var (default
#   "oracle-worker"); set a distinct value per host when scaling horizontally.
WORKER_ID=oracle-worker

# POLL_INTERVAL_SEC — seconds between queue polls when the worker is idle.
#   Secret? No. Range 1-300; the image default (5) is right for one worker.
#   Lower = faster pickup, more idle DB queries; higher = slower pickup.
POLL_INTERVAL_SEC=5

# CONCURRENCY — max concurrent render jobs for this worker.
#   Secret? No. Range 1-4. Start with 1 (one x264 encode ≈ one vCPU + ~2 GB
#   RAM). Raise only on a host with the headroom — the compose resource
#   limits (3.5 cpus / 6G) match the default of 1 + chapter concurrency 2.
CONCURRENCY=1

# WORKER_CHAPTER_CONCURRENCY — max chapters rendered concurrently *within*
#   one chapter-mode job. Secret? No. Range 1-8, default 2. Chapter renders
#   are CPU/ffmpeg-bound; 2-3 is the sane default.
WORKER_CHAPTER_CONCURRENCY=2

# WORK_DIR — working directory for downloads and per-scene segments.
#   Secret? No. Inside Docker this is a tmpfs (RAM disk, 8 GB cap in
#   docker-compose.yml); segments are deleted after each job, so nothing
#   persists. For the systemd path use a real dir, e.g.
#   /var/lib/vidora-worker/work.
WORK_DIR=/tmp/vidora-worker
