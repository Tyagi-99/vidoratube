# Vidora local / server env template — copy to `.env` and fill values.
# Never commit real secrets. Publishable keys are still sensitive in some contexts; prefer dashboard secrets for production.

# Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Lovable AI gateway (planning + Gemini image)
LOVABLE_API_KEY=

# Stock
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Voice
ELEVENLABS_API_KEY=

# Optional / legacy
SHOTSTACK_API_KEY=
SHOTSTACK_ENV=stage
FAL_API_KEY=

# YouTube / Google OAuth (server-only)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# OpenAI (Mode 2 commentary; falls back to LOVABLE_API_KEY / Gemini)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
