# Vidora local / server env template — copy to `.env` and fill values.
# Never commit real secrets. Publishable keys are still sensitive in some contexts; prefer dashboard secrets for production.

# Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Lovable AI gateway (planning + Gemini image)
LOVABLE_API_KEY=

# Stock
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Voice
ELEVENLABS_API_KEY=

# Optional / legacy
SHOTSTACK_API_KEY=
SHOTSTACK_ENV=stage
FAL_API_KEY=

# YouTube / Google OAuth (server-only)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Encrypts YouTube OAuth tokens at rest (AES-256-GCM, server-only).
# Generate with: openssl rand -base64 32
YOUTUBE_TOKEN_ENCRYPTION_KEY=
# Sprint 7–8 workstream A (publishing adapters): founder designates the test
# accounts. Publishing is DISABLED unless these are set (fail closed).
YOUTUBE_TEST_CHANNEL_ID=
META_APP_ID=
META_APP_SECRET=
META_TOKEN_ENCRYPTION_KEY=
META_TEST_PAGE_ID=
META_TEST_IG_USER_ID=

# OpenAI (Mode 2 commentary; falls back to LOVABLE_API_KEY / Gemini)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Billing: Dodo Payments (USD) + Razorpay (INR) ─────────────────────────
# Checkout buttons show "Coming soon" until the matching provider's keys are
# set; they switch on automatically once configured.
# Dodo Payments (Merchant of Record, USD). Dashboard: https://dodopayments.com
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
# Optional: "live" for production, anything else (or empty) = test mode.
DODO_ENVIRONMENT=
# JSON map of plan slug -> Dodo product id (products are created in the
# Dodo dashboard). Example: {"starter":"prod_abc","studio":"prod_def","scale":"prod_ghi"}
DODO_PRODUCT_IDS={}

# Razorpay (INR). Dashboard: https://dashboard.razorpay.com
# All three are required — checkout stays "Coming soon" until all are set.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Render worker (docker compose env_file; Oracle Cloud deploy) ──────────
# Full per-variable reference (what it is, where to get it, secret or not):
#   worker/.env.example
# Everything here flows into the worker via docker-compose.yml env_file.
# Storage bucket for render inputs/outputs (must exist, PRIVATE)
RENDER_BUCKET=generated-videos
# Storage bucket for agency brand-kit logos (must exist, PRIVATE)
BRAND_LOGOS_BUCKET=brand-logos
# Unique ID for this worker instance (used in claim leases + logs)
WORKER_ID=oracle-worker
# Seconds between queue polls when idle (1-300)
POLL_INTERVAL_SEC=5
# Working dir for downloads/segments (tmpfs in compose)
WORK_DIR=/tmp/vidora-worker
# Max concurrent jobs per worker (1-4). Start with 1.
CONCURRENCY=1
# Max chapters rendered concurrently within one chapter-mode job (1-8)
WORKER_CHAPTER_CONCURRENCY=2
