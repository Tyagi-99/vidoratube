# Vidora local / server env template — copy to `.env` and fill values.
# Never commit real secrets. Publishable keys are still sensitive in some contexts; prefer dashboard secrets for production.

# Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Lovable AI gateway (planning + Gemini image)
LOVABLE_API_KEY=

# Stock
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Voice
ELEVENLABS_API_KEY=

# Optional / legacy
SHOTSTACK_API_KEY=
SHOTSTACK_ENV=stage
FAL_API_KEY=

# YouTube / Google OAuth (server-only)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Encrypts YouTube OAuth tokens at rest (AES-256-GCM, server-only).
# Generate with: openssl rand -base64 32
YOUTUBE_TOKEN_ENCRYPTION_KEY=

# OpenAI (Mode 2 commentary; falls back to LOVABLE_API_KEY / Gemini)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Render worker (docker compose env_file; Oracle Cloud deploy) ──────────
# Storage bucket for render inputs/outputs
RENDER_BUCKET=generated-videos
# Unique ID for this worker instance (used in claim leases + logs)
WORKER_ID=oracle-worker
# Seconds between queue polls when idle (1-300)
POLL_INTERVAL_SEC=5
# Working dir for downloads/segments (tmpfs in compose)
WORK_DIR=/tmp/vidora-worker
# Max concurrent jobs per worker (1-4). Start with 1.
CONCURRENCY=1
